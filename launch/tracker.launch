<?xml version="1.0"?>
<!--
  Single Camera Tracker Launch File for ROS 1 (Noetic)

  Usage:
    roslaunch ultralytics_ros tracker.launch
-->
<launch>
  <!-- Arguments -->
  <arg name="yolo_model" default="yolov8m.pt"/>
  <arg name="input_topic" default="/camera/image_raw"/>
  <arg name="result_topic" default="/yolo_result"/>
  <arg name="result_image_topic" default="/yolo_image"/>
  <arg name="conf_thres" default="0.25"/>
  <arg name="iou_thres" default="0.45"/>
  <arg name="max_det" default="300"/>
  <arg name="device" default="cpu"/>
  <arg name="tracking_method" default="ultralytics"/>
  <arg name="tracker" default="bytetrack.yaml"/>

  <!-- BoxMOT parameters -->
  <arg name="boxmot_tracker" default="deepocsort"/>
  <arg name="reid_model" default="osnet_x0_25_msmt17.pt"/>
  <arg name="track_high_thresh" default="0.5"/>
  <arg name="track_low_thresh" default="0.1"/>
  <arg name="new_track_thresh" default="0.6"/>
  <arg name="track_buffer" default="30"/>
  <arg name="match_thresh" default="0.8"/>

  <!-- Visualization -->
  <arg name="result_conf" default="true"/>
  <arg name="result_line_width" default="2"/>
  <arg name="result_font_size" default="1"/>
  <arg name="result_labels" default="true"/>
  <arg name="result_boxes" default="true"/>
  <arg name="debug" default="false"/>

  <!-- Tracker Node -->
  <node pkg="ultralytics_ros" type="tracker_node_ros1.py" name="tracker_node" output="screen">
    <param name="yolo_model" value="$(arg yolo_model)"/>
    <param name="input_topic" value="$(arg input_topic)"/>
    <param name="result_topic" value="$(arg result_topic)"/>
    <param name="result_image_topic" value="$(arg result_image_topic)"/>
    <param name="conf_thres" value="$(arg conf_thres)"/>
    <param name="iou_thres" value="$(arg iou_thres)"/>
    <param name="max_det" value="$(arg max_det)"/>
    <param name="device" value="$(arg device)"/>
    <param name="tracking_method" value="$(arg tracking_method)"/>
    <param name="tracker" value="$(arg tracker)"/>

    <!-- BoxMOT parameters -->
    <param name="boxmot_tracker" value="$(arg boxmot_tracker)"/>
    <param name="reid_model" value="$(arg reid_model)"/>
    <param name="track_high_thresh" value="$(arg track_high_thresh)"/>
    <param name="track_low_thresh" value="$(arg track_low_thresh)"/>
    <param name="new_track_thresh" value="$(arg new_track_thresh)"/>
    <param name="track_buffer" value="$(arg track_buffer)"/>
    <param name="match_thresh" value="$(arg match_thresh)"/>

    <!-- Visualization parameters -->
    <param name="result_conf" value="$(arg result_conf)"/>
    <param name="result_line_width" value="$(arg result_line_width)"/>
    <param name="result_font_size" value="$(arg result_font_size)"/>
    <param name="result_labels" value="$(arg result_labels)"/>
    <param name="result_boxes" value="$(arg result_boxes)"/>
  </node>

  <!-- Debug: View result image -->
  <node if="$(arg debug)" pkg="image_view" type="image_view" name="result_viewer">
    <remap from="image" to="$(arg result_image_topic)"/>
  </node>
</launch>
