<?xml version="1.0"?>
<!--
  Multi-Camera Tracker Launch File for ROS 1 (Noetic)
  For 4-camera 360° panoramic tracking system

  Usage:
    roslaunch ultralytics_ros multi_camera_tracker.launch
-->
<launch>
  <!-- Arguments -->
  <arg name="yolo_model" default="yolov8m.pt"/>
  <arg name="num_cameras" default="4"/>

  <!-- Camera topics -->
  <arg name="camera0_topic" default="/camera0/image_raw"/>
  <arg name="camera1_topic" default="/camera1/image_raw"/>
  <arg name="camera2_topic" default="/camera2/image_raw"/>
  <arg name="camera3_topic" default="/camera3/image_raw"/>

  <!-- Result topics -->
  <arg name="result_topic_prefix" default="/yolo_result"/>
  <arg name="result_image_topic_prefix" default="/yolo_image"/>

  <!-- Detection parameters -->
  <arg name="conf_thres" default="0.25"/>
  <arg name="iou_thres" default="0.45"/>
  <arg name="max_det" default="300"/>
  <arg name="device" default="cpu"/>

  <!-- BoxMOT parameters -->
  <arg name="boxmot_tracker" default="deepocsort"/>
  <arg name="reid_model" default="osnet_x0_25_msmt17.pt"/>
  <arg name="track_high_thresh" default="0.5"/>
  <arg name="track_low_thresh" default="0.1"/>
  <arg name="new_track_thresh" default="0.6"/>
  <arg name="track_buffer" default="40"/>
  <arg name="match_thresh" default="0.8"/>

  <!-- Synchronization -->
  <arg name="use_time_sync" default="true"/>
  <arg name="sync_queue_size" default="10"/>
  <arg name="sync_slop" default="0.1"/>

  <!-- Visualization -->
  <arg name="result_conf" default="true"/>
  <arg name="result_line_width" default="2"/>
  <arg name="result_font_size" default="1"/>
  <arg name="result_labels" default="true"/>
  <arg name="result_boxes" default="true"/>
  <arg name="debug" default="false"/>

  <!-- Multi-Camera Tracker Node -->
  <node pkg="ultralytics_ros" type="multi_camera_tracker_node_ros1.py" name="multi_camera_tracker_node" output="screen">
    <param name="yolo_model" value="$(arg yolo_model)"/>
    <param name="num_cameras" value="$(arg num_cameras)"/>

    <!-- Camera topics -->
    <rosparam param="input_topics">
      ["$(arg camera0_topic)", "$(arg camera1_topic)", "$(arg camera2_topic)", "$(arg camera3_topic)"]
    </rosparam>

    <param name="result_topic_prefix" value="$(arg result_topic_prefix)"/>
    <param name="result_image_topic_prefix" value="$(arg result_image_topic_prefix)"/>

    <!-- Detection parameters -->
    <param name="conf_thres" value="$(arg conf_thres)"/>
    <param name="iou_thres" value="$(arg iou_thres)"/>
    <param name="max_det" value="$(arg max_det)"/>
    <param name="device" value="$(arg device)"/>

    <!-- BoxMOT parameters -->
    <param name="boxmot_tracker" value="$(arg boxmot_tracker)"/>
    <param name="reid_model" value="$(arg reid_model)"/>
    <param name="track_high_thresh" value="$(arg track_high_thresh)"/>
    <param name="track_low_thresh" value="$(arg track_low_thresh)"/>
    <param name="new_track_thresh" value="$(arg new_track_thresh)"/>
    <param name="track_buffer" value="$(arg track_buffer)"/>
    <param name="match_thresh" value="$(arg match_thresh)"/>

    <!-- Synchronization -->
    <param name="use_time_sync" value="$(arg use_time_sync)"/>
    <param name="sync_queue_size" value="$(arg sync_queue_size)"/>
    <param name="sync_slop" value="$(arg sync_slop)"/>

    <!-- Visualization -->
    <param name="result_conf" value="$(arg result_conf)"/>
    <param name="result_line_width" value="$(arg result_line_width)"/>
    <param name="result_font_size" value="$(arg result_font_size)"/>
    <param name="result_labels" value="$(arg result_labels)"/>
    <param name="result_boxes" value="$(arg result_boxes)"/>
  </node>

  <!-- Debug: View result images -->
  <group if="$(arg debug)">
    <node pkg="image_view" type="image_view" name="camera0_viewer">
      <remap from="image" to="$(arg result_image_topic_prefix)_camera0"/>
    </node>
  </group>
</launch>
